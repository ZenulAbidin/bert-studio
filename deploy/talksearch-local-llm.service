[Unit]
Description=Private local Qwen evidence-review server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/talksearch-mirror/local-llm.env
ExecStartPre=-/usr/bin/podman rm -f talksearch-local-llm
ExecStart=/usr/bin/podman run --rm --name talksearch-local-llm --network bert-studio --network-alias local-llm --security-opt no-new-privileges --cap-drop all --device /dev/nvidia0 --device /dev/nvidiactl --device /dev/nvidia-uvm --device /dev/nvidia-uvm-tools -v /lib64/libcuda.so.1:/usr/lib/x86_64-linux-gnu/libcuda.so.1:ro -v /opt/local-llm/qwen2.5-3b:/root/.cache/llama.cpp:rw -p 127.0.0.1:5030:5030 ghcr.io/ggml-org/llama.cpp:server-cuda -hf Qwen/Qwen2.5-3B-Instruct-GGUF:Q4_K_M -ngl 99 -c 4096 --host 0.0.0.0 --port 5030
ExecStop=/usr/bin/podman stop -t 30 talksearch-local-llm
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
