# Copy to backend/.env.local on the host. Do not commit that file.
# Replace every replace-with-... value with a long random string,
# for example the output of: openssl rand -base64 32
MONGODB_CONNECTION_STRING=mongodb://mongo:27017
MONGODB_DATABASE_NAME=bert_studio
SESSION_SECRET=replace-with-a-long-random-secret
AUTH_USERNAME=bert-admin
AUTH_PASSWORD=replace-with-a-strong-password
HF_HOME=/models/huggingface
TRANSFORMERS_CACHE=/models/huggingface/transformers
MODEL_CACHE_DIR=/models
AI_DETECTOR_MODEL=openai-community/roberta-base-openai-detector
AI_DETECTOR_POSITIVE_LABEL=Fake
# Only for the internal batch worker endpoint. Keep this host-only.
INTERNAL_SCORER_TOKEN=replace-with-a-second-long-random-secret
INFERENCE_DEVICE=auto
